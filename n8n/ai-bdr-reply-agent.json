    {
      "parameters": {
        "jsCode": "\n// Rows to act on, never sent yet and passed the check: a \"yes\" in Send with a draft, and every unsubscribe\n// (blocked without approval, so the address never gets another email).\nconst INTEREST = { interested: 1, referral: -2, not_interested: -1, unsubscribe: -1, out_of_office: 0 };\nreturn $input.all().map(i => i.json)\n  .filter(r => r.Id && !String(r.Sent || '').trim())\n  .filter(r => r.Check === 'ok')\n  .filter(r => r.Category === 'unsubscribe' ||\n               (String(r.Send || '').trim().toLowerCase() === 'yes' && String(r.Draft || '').trim()))\n  .map(r => ({ json: { ...r, action: r.Category === 'unsubscribe' ? 'block' : 'reply',\n                       interest: INTEREST[r.Category] ?? null } }));\n"
      },
      "id": "51441f14-49e8-4b9a-8160-281d01eff26c",
      "name": "Approved or unsubscribe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.action === 'block' ? 'https://api.instantly.ai/api/v2/block-lists-entries' : 'https://api.instantly.ai/api/v2/emails/reply' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.action === 'block' ? { bl_value: $json.Lead } : { eaccount: $json.Mailbox, reply_to_uuid: $json.Id, subject: $json.Subject, body: { text: $json.Draft, html: String($json.Draft).trim().split(/\\n\\s*\\n/).map(p => '<p>' + p.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\\n/g, '<br>') + '</p>').join('') } }) }}"
      },
      "id": "54650562-ae16-43f1-b73b-4e352c1dc5a4",
      "name": "Reply or block",
      "type": "n8n-nodes-base.httpRequest",
