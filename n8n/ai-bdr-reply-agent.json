      "id": "8771a668-4f80-4f51-9e11-29b180da5bc1",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1060,
        200
      ],
      "credentials": {
